POSTGRES_DB=smart
POSTGRES_USER=smart
POSTGRES_PASSWORD=change-me
SMART_JWT_SECRET=change-me-to-a-random-32-byte-string
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# gpt-5 계열 추론 강도(minimal·low·medium·high). 기본값 minimal은 호출당 1초 안팎이고, 기본 강도는 8~10초다.
# 추론을 쓰지 않는 모델이면 이 값을 비워 둔다(OPENAI_REASONING_EFFORT=).
OPENAI_REASONING_EFFORT=minimal
