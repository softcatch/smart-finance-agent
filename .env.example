POSTGRES_DB=smart
POSTGRES_USER=smart
POSTGRES_PASSWORD=change-me
SMART_JWT_SECRET=change-me-to-a-random-32-byte-string
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# gpt-5 계열 추론 강도(minimal·low·medium·high). 같은 모델로 잰 호출당 지연: 기본(medium) 4~11초,
# low 약 2.7초, minimal 약 1.2초. minimal은 빠르지만 의도 추출을 자주 놓쳐 low를 기본으로 쓴다.
# 추론을 쓰지 않는 모델이면 이 값을 비워 둔다(OPENAI_REASONING_EFFORT=).
OPENAI_REASONING_EFFORT=low
