POSTGRES_DB=smart
POSTGRES_USER=smart
POSTGRES_PASSWORD=change-me
SMART_JWT_SECRET=change-me-to-a-random-32-byte-string
# DART 오픈API 인증키(opendart.fss.or.kr에서 무료 발급). 비워 두면 재무 수집을 건너뛴다.
DART_API_KEY=
# 채팅 LLM과 사업의 내용 임베딩에 쓴다. 비워 두면 collector가 사업의 내용 수집만 건너뛴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# gpt-5 계열 추론 강도(minimal·low·medium·high). 같은 모델로 잰 호출당 지연: 기본(medium) 4~11초,
# low 약 2.7초, minimal 약 1.2초. minimal은 빠르지만 의도 추출을 자주 놓쳐 low를 기본으로 쓴다.
# 추론을 쓰지 않는 모델이면 이 값을 비워 둔다(OPENAI_REASONING_EFFORT=).
OPENAI_REASONING_EFFORT=low
# OpenAI가 오류(429·5xx·연결 실패)나 타임아웃이면 같은 요청을 Claude로 한 번 더 보낸다(NFR-056).
# 비워 두면 대체 없이 OpenAI만 쓴다. 모델은 강제 도구 호출을 지원해야 한다(Haiku 5.5, Opus·Sonnet 5.5는 아님).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# 관리자 아이디(쉼표로 구분, FR-030). 이 아이디로 먼저 가입한 사람이 관리자가 된다.
# 이미 가입한 회원은 DB에서 member.role을 ADMIN으로 바꿔 지정한다. 비우면 가입으로는 관리자가 생기지 않는다.
SMART_ADMIN_LOGIN_IDS=
# 도메인과 HTTPS(NFR-053). 서버에서만 쓴다 — nginx가 이 도메인의 80·443을 받고 certbot이 Let's Encrypt 인증서를 발급·갱신한다.
# 로컬 개발·부하 측정은 이 값 없이 Spring(8080)을 직접 쓴다(프로필 proxy를 켜지 않는다).
DOMAIN=
LETSENCRYPT_EMAIL=
# 1이면 Let's Encrypt 시험용(스테이징) 서버로 발급한다. 처음 시험할 때 켜고, 확인한 뒤 비워서 다시 올린다.
LETSENCRYPT_STAGING=
