POSTGRES_DB=smart
POSTGRES_USER=smart
POSTGRES_PASSWORD=change-me
SMART_JWT_SECRET=change-me-to-a-random-32-byte-string
# DART 오픈API 인증키(opendart.fss.or.kr에서 무료 발급). 비워 두면 재무 수집을 건너뛴다.
DART_API_KEY=
# 채팅 LLM과 사업의 내용 임베딩에 쓴다. 비워 두면 collector가 사업의 내용 수집만 건너뛴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# gpt-5 계열 추론 강도(minimal·low·medium·high). 같은 모델로 잰 호출당 지연: 기본(medium) 4~11초,
# low 약 2.7초, minimal 약 1.2초. minimal은 빠르지만 의도 추출을 자주 놓쳐 low를 기본으로 쓴다.
# 추론을 쓰지 않는 모델이면 이 값을 비워 둔다(OPENAI_REASONING_EFFORT=).
OPENAI_REASONING_EFFORT=low
# OpenAI가 오류(429·5xx·연결 실패)나 타임아웃이면 같은 요청을 Claude로 한 번 더 보낸다(NFR-056).
# 비워 두면 대체 없이 OpenAI만 쓴다. 모델은 강제 도구 호출을 지원해야 한다(Haiku 5.5, Opus·Sonnet 5.5는 아님).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
